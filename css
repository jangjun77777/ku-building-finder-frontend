:root{
  --ku:#8B0000;
  --ku-dark:#6d0000;
  --bg:#f4f5f7;
  --surface:#ffffff;
  --border:#e5e7eb;
  --text:#1f2937;
  --muted:#6b7280;
  --radius:18px;
  --shadow:0 10px 30px rgba(0,0,0,.08);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html,body{
  height:100%;
  font-family:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
  color:var(--text);
}

body{
  background:url("../images/ku-mainhall-bg.jpeg") center/cover fixed no-repeat;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.35);
  z-index:-1;
}

.app{
  height:100vh;
  display:flex;
  flex-direction:column;
  backdrop-filter:blur(8px);
  overflow:hidden;
}

.topbar{
  flex-shrink:0;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  padding:18px 28px;
  background:rgba(255,255,255,.94);
  border-bottom:1px solid var(--border);
}

.brand{
  display:flex;
  align-items:center;
  gap:16px;
}

.logo{
  width:54px;
  height:54px;
  border-radius:50%;
  background:var(--ku);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  font-size:18px;
  flex-shrink:0;
}

.brand h1{
  font-size:1.35rem;
  color:var(--ku);
}

.brand p{
  color:var(--muted);
  font-size:.9rem;
  margin-top:2px;
}

.menu-btn{
  display:none;
  border:none;
  background:var(--ku);
  color:#fff;
  padding:10px 16px;
  border-radius:999px;
  cursor:pointer;
  font-weight:600;
}

.layout{
  flex:1;
  min-height:0;
  display:grid;
  grid-template-columns:2.8fr 1.1fr;
  gap:24px;
  padding:24px;
  overflow:hidden;
}

.chat-section{
  min-height:0;
  background:rgba(255,255,255,.94);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.chat-window{
  flex:1;
  min-height:0;
  overflow-y:auto;
  overflow-x:hidden;
  background:var(--bg);
  padding:24px;
  display:flex;
  flex-direction:column;
  gap:16px;
}

.bot-message,
.user-message{
  display:flex;
  gap:16px;
  align-items:flex-start;
}

.user-message{
  justify-content:flex-end;
}

.user-message .avatar{
  order:2;
  background:#374151;
}

.user-message .message{
  order:1;
  background:var(--ku);
  color:#fff;
  border:none;
}

.avatar{
  width:44px;
  height:44px;
  border-radius:50%;
  background:var(--ku);
  color:#fff;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-shrink:0;
}

.message{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:18px;
  max-width:760px;
  line-height:1.65;
  box-shadow:0 4px 14px rgba(0,0,0,.04);
  white-space:pre-wrap;
}

.message h3{
  margin-bottom:10px;
}

.message p{
  line-height:1.7;
  color:#444;
}

.user-message .message p,
.user-message .message a{
  color:#fff;
}

.message a{
  color:var(--ku);
  font-weight:600;
  word-break:break-all;
}

.examples{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:18px;
}

.example-btn,
.chip{
  border:1px solid var(--border);
  background:#fff;
  color:#333;
  border-radius:999px;
  padding:8px 14px;
  cursor:pointer;
  transition:.2s;
  font-size:.9rem;
}

.example-btn:hover,
.chip:hover{
  background:var(--ku);
  color:#fff;
  border-color:var(--ku);
}

.quick-panel{
  flex-shrink:0;
  border-top:1px solid var(--border);
  background:#fff;
  padding:14px 22px;
}

.quick-panel summary{
  cursor:pointer;
  font-weight:600;
  color:var(--ku);
}

.chips{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:14px;
}

.input-area{
  flex-shrink:0;
  display:flex;
  gap:12px;
  padding:18px;
  border-top:1px solid var(--border);
  background:#fff;
}

.input-area input{
  flex:1;
  border:1px solid var(--border);
  border-radius:999px;
  padding:14px 18px;
  font-size:15px;
}

.input-area input:focus{
  outline:none;
  border-color:var(--ku);
  box-shadow:0 0 0 3px rgba(139,0,0,.12);
}

.input-area button{
  background:var(--ku);
  color:#fff;
  border:none;
  border-radius:999px;
  padding:0 24px;
  cursor:pointer;
  transition:.2s;
  font-weight:600;
}

.input-area button:hover{
  background:var(--ku-dark);
}

.input-area button:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.sidebar{
  min-height:0;
  background:rgba(255,255,255,.94);
  border-radius:var(--radius);
  padding:24px;
  box-shadow:var(--shadow);
  overflow-y:auto;
  overflow-x:hidden;
}

.sidebar h2{
  color:var(--ku);
}

.sidebar h3{
  color:var(--ku);
  margin-bottom:10px;
}

.sidebar-intro{
  color:var(--muted);
  margin:10px 0 18px;
  line-height:1.5;
}

.hub-card{
  display:flex;
  gap:14px;
  align-items:center;
  text-decoration:none;
  color:inherit;
  background:#fff;
  border:1px solid var(--border);
  border-radius:14px;
  padding:15px;
  margin-bottom:14px;
  transition:.2s;
}

.hub-card:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 18px rgba(0,0,0,.08);
}

.hub-card span{
  width:44px;
  height:44px;
  border-radius:12px;
  background:var(--ku);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  flex-shrink:0;
}

.hub-card strong{
  display:block;
}

.hub-card small{
  color:var(--muted);
  line-height:1.4;
}

.sidebar-footer{
  margin-top:26px;
  border-top:1px solid var(--border);
  padding-top:20px;
}

.sidebar-footer ul{
  margin:12px 0 18px 20px;
  line-height:1.9;
}

.sidebar-footer p{
  color:var(--muted);
  font-size:.9rem;
}

.support-box{
  margin-top:18px;
  padding:14px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:14px;
}

.support-box p{
  color:var(--muted);
  font-size:.9rem;
  line-height:1.5;
  margin-top:6px;
}

@media(max-width:960px){

  .app{
    height:auto;
    min-height:100vh;
    overflow:visible;
  }

  .menu-btn{
    display:block;
  }

  .layout{
    grid-template-columns:1fr;
    overflow:visible;
  }

  .chat-section{
    order:1;
    height:70vh;
    min-height:0;
  }

  .sidebar{
    order:2;
    max-height:none;
  }

  .topbar{
    flex-wrap:wrap;
  }

}

@media(max-width:640px){

  body{
    background-attachment:scroll;
  }

  .layout{
    padding:12px;
    gap:12px;
  }

  .topbar{
    padding:14px;
  }

  .brand{
    gap:12px;
  }

  .logo{
    width:46px;
    height:46px;
    font-size:16px;
  }

  .brand h1{
    font-size:1.1rem;
  }

  .brand p{
    display:none;
  }

  .menu-btn{
    width:100%;
  }

  .chat-window{
    padding:16px;
  }

  .bot-message,
  .user-message{
    gap:10px;
  }

  .avatar{
    width:36px;
    height:36px;
    font-size:14px;
  }

  .message{
    max-width:calc(100% - 46px);
    padding:14px;
    font-size:.95rem;
  }

  .input-area{
    flex-direction:column;
    padding:14px;
  }

  .input-area button{
    height:48px;
  }

  .sidebar{
    padding:18px;
  }

}
