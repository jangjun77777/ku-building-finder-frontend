
:root{
  --ku:#8B0000;
  --ku-dark:#6d0000;
  --bg:#f4f5f7;
  --surface:#ffffff;
  --border:#e5e7eb;
  --text:#1f2937;
  --muted:#6b7280;
  --radius:18px;
  --shadow:0 10px 30px rgba(0,0,0,.08);
}

*{margin:0;padding:0;box-sizing:border-box}

html,body{
  height:100%;
  font-family:"Inter",system-ui,sans-serif;
  color:var(--text);
}

body{
  background:url("../images/ku-mainhall-bg.jpeg") center/cover fixed no-repeat;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.35);
  z-index:-1;
}

.app{
  min-height:100vh;
  display:flex;
  flex-direction:column;
  backdrop-filter:blur(8px);
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:18px 28px;
  background:rgba(255,255,255,.92);
  border-bottom:1px solid var(--border);
}

.brand{
  display:flex;
  align-items:center;
  gap:16px;
}

.logo{
  width:54px;
  height:54px;
  border-radius:50%;
  background:var(--ku);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
  font-size:18px;
}

.brand h1{
  font-size:1.35rem;
  color:var(--ku);
}

.brand p{
  color:var(--muted);
  font-size:.9rem;
}

.menu-btn{
  display:none;
  border:none;
  background:var(--ku);
  color:#fff;
  padding:10px 16px;
  border-radius:999px;
  cursor:pointer;
}

.layout{
  flex:1;
  display:grid;
  grid-template-columns:2.8fr 1.1fr;
  gap:24px;
  padding:24px;
}

.chat-section{
  background:rgba(255,255,255,.92);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.chat-window{
  flex:1;
  overflow:auto;
  background:var(--bg);
  padding:24px;
}

.bot-message{
  display:flex;
  gap:16px;
  align-items:flex-start;
}

.avatar{
  width:44px;
  height:44px;
  border-radius:50%;
  background:var(--ku);
  color:#fff;
  display:flex;
  justify-content:center;
  align-items:center;
}

.message{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:18px;
  max-width:760px;
  box-shadow:0 4px 14px rgba(0,0,0,.04);
}

.message h3{margin-bottom:10px}
.message p{line-height:1.7;color:#444}

.examples{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:18px;
}

.example-btn,.chip{
  border:1px solid var(--border);
  background:#fff;
  border-radius:999px;
  padding:8px 14px;
  cursor:pointer;
  transition:.2s;
}

.example-btn:hover,.chip:hover{
  background:var(--ku);
  color:#fff;
}

.quick-panel{
  border-top:1px solid var(--border);
  background:#fff;
  padding:14px 22px;
}

.quick-panel summary{
  cursor:pointer;
  font-weight:600;
}

.chips{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:14px;
}

.input-area{
  display:flex;
  gap:12px;
  padding:18px;
  border-top:1px solid var(--border);
  background:#fff;
}

.input-area input{
  flex:1;
  border:1px solid var(--border);
  border-radius:999px;
  padding:14px 18px;
  font-size:15px;
}

.input-area input:focus{
  outline:none;
  border-color:var(--ku);
}

.input-area button{
  background:var(--ku);
  color:#fff;
  border:none;
  border-radius:999px;
  padding:0 24px;
  cursor:pointer;
  transition:.2s;
}

.input-area button:hover{
  background:var(--ku-dark);
}

.sidebar{
  background:rgba(255,255,255,.92);
  border-radius:var(--radius);
  padding:24px;
  box-shadow:var(--shadow);
  overflow:auto;
}

.sidebar h2{
  color:var(--ku);
}

.sidebar-intro{
  color:var(--muted);
  margin:10px 0 18px;
}

.hub-card{
  display:flex;
  gap:14px;
  align-items:center;
  text-decoration:none;
  color:inherit;
  background:#fff;
  border:1px solid var(--border);
  border-radius:14px;
  padding:15px;
  margin-bottom:14px;
  transition:.2s;
}

.hub-card:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 18px rgba(0,0,0,.08);
}

.hub-card span{
  font-size:28px;
}

.hub-card strong{
  display:block;
}

.hub-card small{
  color:var(--muted);
}

.sidebar-footer{
  margin-top:26px;
  border-top:1px solid var(--border);
  padding-top:20px;
}

.sidebar-footer ul{
  margin:12px 0 18px 20px;
  line-height:1.9;
}

.sidebar-footer p{
  color:var(--muted);
  font-size:.9rem;
}

@media(max-width:960px){

  .menu-btn{
    display:block;
  }

  .layout{
    grid-template-columns:1fr;
  }

  .sidebar{
    order:2;
  }

  .chat-section{
    order:1;
  }

  .topbar{
    flex-wrap:wrap;
    gap:14px;
  }

}

@media(max-width:640px){

  .layout{
    padding:12px;
    gap:12px;
  }

  .topbar{
    padding:14px;
  }

  .brand h1{
    font-size:1.1rem;
  }

  .brand p{
    display:none;
  }

  .message{
    padding:14px;
  }

  .input-area{
    flex-direction:column;
  }

  .input-area button{
    height:48px;
  }

}
